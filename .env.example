# ---- Vault Router UI environment ----
# Copy to .env.local and fill in.

# WalletConnect Cloud project id (required by RainbowKit). Get one free at
# https://cloud.walletconnect.com  — without it, injected wallets still work but
# WalletConnect/mobile QR will be disabled.
NEXT_PUBLIC_WC_PROJECT_ID=

# Address of the deployed Vault Router diamond (the ERC-4626 entry point).
# Leave blank until deployed — the UI runs in "not deployed" mode and shows a banner.
NEXT_PUBLIC_VAULT_ADDRESS=

# Which chain the diamond is deployed on. 42161 = Arbitrum One, 421614 = Arbitrum Sepolia.
NEXT_PUBLIC_CHAIN_ID=421614

# Optional: override RPC endpoints (otherwise public defaults are used).
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# 8-digit transaction PIN required to confirm deposit/withdraw/request-exit in
# the UI before the wallet prompt opens. UI confirmation gate only — the wallet
# signature remains the real authorization. Defaults to 12345678 if unset.
NEXT_PUBLIC_TX_PASSCODE=12345678
